#!/usr/bin/env bash
# Rejects staged file names and added lines containing a guard term from any company vault listed in .company.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
conf="$root/.company"
fail() { echo "pre-commit: $1; run /cairn:setup to repair" >&2; exit 1; }

[ -f "$conf" ] || fail "$conf is missing"
files=$(sed -n 's/^terms=//p' "$conf")
[ -n "$files" ] || fail "$conf has no terms= line"

patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
while IFS= read -r f; do
  f="${f/#\~/$HOME}"
  [ -f "$f" ] || fail "guard terms file '$f' not found"
  sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' "$f" >> "$patterns"
done <<< "$files"
[ -s "$patterns" ] || fail "no guard terms are listed"

hits=$( { git diff --cached --name-only --diff-filter=ACMR
          git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++' || true
        } | grep -iF -f "$patterns" || true)
if [ -n "$hits" ]; then
  echo "pre-commit: guard terms found in staged changes:" >&2
  echo "$hits" | head -20 >&2
  echo "pre-commit: move these lines to the company vault or reword them without the term, then commit again" >&2
  exit 1
fi
